# PostgreSQL connection string (use your hosted PostgreSQL URL on Vercel)
# If the password contains @, :, /, #, or %, URL-encode it.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# JWT authentication
# Generate a long random value. Do not reuse the placeholder in production.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRE="7d"

# SMTP / Nodemailer (required for OTP, verification, invites and password reset)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-app-password"
FROM_EMAIL="your-email@example.com"
FROM_NAME="PolyAttend"

# Optional: only set this when the API is hosted on a different origin.
# For the normal Vercel deployment, leave it unset so the app uses /api.
# NEXT_PUBLIC_API_URL="https://api.example.com"

# ── Redis cache (optional) ──────────────────────────────────────────────────
# BOTH lines are required to enable Redis. Leave them unset and the app falls
# back to an in-process cache, which still works but only helps within a single
# server instance and does not share rate-limit counters between instances.
#
# Get them free at https://console.upstash.com -> Create a new Redis database.
# The two values are shown on the database's "REST API" page.
#
# What Redis is used for:
#   - caching hot reads: /auth/me, /settings, /departments, dashboard counts,
#     and the per-semester student roster the Department Admin dashboard loads
#   - the auth rate limiter, which then becomes a real shared limit instead of a
#     per-instance one
#
# Verify after deploying: GET /api/health -> cache.backend is "redis".
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxxxxxxxxxxxxxxx"

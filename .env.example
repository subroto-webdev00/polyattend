# PostgreSQL connection string (use your hosted PostgreSQL URL on Vercel)
# If the password contains @, :, /, #, or %, URL-encode it.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# JWT authentication
# Generate a long random value. Do not reuse the placeholder in production.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRE="7d"

# SMTP / Nodemailer (required for OTP, verification, invites and password reset)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-app-password"
FROM_EMAIL="your-email@example.com"
FROM_NAME="PolyAttend"

# Optional: only set this when the API is hosted on a different origin.
# For the normal Vercel deployment, leave it unset so the app uses /api.
# NEXT_PUBLIC_API_URL="https://api.example.com"
